# ── Listener ─────────────────────────────────────────────────────────────────
CRAWL_HOST=0.0.0.0
CRAWL_PORT=8080

# Public origin, used inside generated policy files (sitemap URLs, llms.txt
# links). Must match what crawlers actually resolve, or the URLs you plant
# will point somewhere that does not exist.
CRAWL_ORIGIN=https://docs.example.org

CRAWL_SENSOR_ID=crawl-01

# ── Capture ──────────────────────────────────────────────────────────────────
CRAWL_LOG_DIR=data/events

# Signing key for beacons. Generated on first run and persisted. It MUST stay
# stable: rotate it and every token minted beforehand stops verifying, silently
# discarding trap hits from crawlers that cached your robots.txt.
CRAWL_SECRET_FILE=data/beacon.secret
# CRAWL_BEACON_SECRET=<passphrase, overrides the file>

# ── Site shape ───────────────────────────────────────────────────────────────
# Changing the seed regenerates every page, which changes every ETag and makes
# earlier conditional-request measurements incomparable. Set it once.
CRAWL_SITE_SEED=mirage-crawl-v1
CRAWL_PROJECTS=40
CRAWL_PAGES_PER_PROJECT=12
CRAWL_FORK_EVERY=5

# ── Identity verification ────────────────────────────────────────────────────
CRAWL_VERIFY_IDENTITY=true
CRAWL_RANGES_FILE=config/crawler_ranges.json

# Reuse one beacon per (client, standard) inside this window so a crawler
# refetching robots.txt in a loop does not mint thousands. 0 mints every time.
CRAWL_BEACON_REUSE_SECONDS=300

# ── Internal sockets ─────────────────────────────────────────────────────────
# The TLS front connects here; X-Forwarded-For and the JA4 header are trusted
# on this socket and nowhere else. Created 0600. Empty disables it.
CRAWL_FRONT_SOCKET=data/front.sock
# /healthz is served only here (curl --unix-socket data/admin.sock http://x/healthz).
CRAWL_ADMIN_SOCKET=data/admin.sock

# ── Behind a reverse proxy ───────────────────────────────────────────────────
# Only if a proxy you control terminates the connection. The header is trusted
# only on CRAWL_PROXY_LISTEN, a separate listener the proxy connects to; the
# sensor refuses to start if one is set without the other.
# Note: a proxy also normalises header order, which costs you the strongest
# impersonation signal. Running this directly on :80 keeps that intact.
# CRAWL_TRUST_PROXY_HEADER=X-Forwarded-For
# CRAWL_PROXY_LISTEN=127.0.0.1:8081

# ────────────────────────────────────────────────────────────────────────────
# Compute-hijack detection
# Serve plausible responses to probes for exposed compute (Ollama, Ray, YARN,
# Docker, Jupyter...). A 404 ends the interaction; a decoy makes the scanner
# proceed to the stage that actually carries the payload, which is the only
# stage with wallet addresses and C2 URLs in it. The decoys are static JSON
# and nothing is ever executed.
#
# Turning this on makes the host look like a vulnerable target. That is the
# point of a honeypot and it is the same posture mirage-core takes on port 22,
# but decide it deliberately.
CRAWL_HUNT_DECOYS=true

# Request bodies are captured on every route, once, up to CRAWL_BODY_BYTES
# (sha256 over all of it). Events carry the first CRAWL_BODY_LOG_BYTES.
# CRAWL_HUNT_BODY_BYTES is still accepted as the old name.
CRAWL_BODY_BYTES=65536
CRAWL_BODY_LOG_BYTES=16384

# ────────────────────────────────────────────────────────────────────────────
# TLS fingerprinting
# The TLS front (python -m mirage_crawl.tlsfront) terminates TLS, computes
# JA4 from the raw ClientHello, and forwards here with the fingerprint in
# this header. The sensor can trust it only because the front strips any
# client-supplied copy before injecting its own.
CRAWL_JA4_HEADER=X-Mirage-JA4
# ── Faces and personas ───────────────────────────────────────────────────────
# Hostnames the documentation face answers to (comma-separated). Empty = derive
# from CRAWL_ORIGIN. A request whose Host matches gets the docs site; a bare IP,
# a wrong name or no Host gets the attack face.
# CRAWL_SITE_HOSTS=docs.example.org

# Per-service persona ports. A bare name uses the conventional port; or pin one
# with name:port. Each port looks like exactly that service (banner included)
# and only answers that service's paths, so /api/version is unambiguous.
# The "php" persona is a WordPress/PHP site that looks exploitable: traversal,
# SQLi, phpinfo, CMS and webshell-upload shapes each get an inert, seed-derived
# page and are captured + tagged. It needs an explicit port (its conventional
# 80/8080 is the public site's), and like every decoy here it executes nothing.
# CRAWL_PERSONA_PORTS=ollama:11434,ray:8265,docker:2375,jupyter:8888,php:8081

# Server header on every response. Default "nginx" hides the aiohttp stack;
# personas override it with their own banner.
# CRAWL_SERVER_HEADER=nginx
