[Unit]
Description=Mirage crawler-measurement sensor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirage
WorkingDirectory=/opt/mirage-crawl
EnvironmentFile=/opt/mirage-crawl/.env
ExecStart=/opt/mirage-crawl/.venv/bin/python run.py
Restart=always
RestartSec=5

# Bind :80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mirage-crawl/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
